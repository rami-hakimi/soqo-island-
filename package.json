{
  "name": "soqo-island",
  "version": "2.0.0-beta.2",
  "description": "Soqo Island — A Living Island for Windows (سوكو آيلاند)",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check-syntax.js",
    "lint": "eslint .",
    "test": "node --require ./test/helpers/setup.js --test \"test/*.test.js\"",
    "verify": "npm run check && npm run lint && npm run typecheck && npm run i18n:check && npm test && npm run notices -- --check",
    "helper:build": "cmd /c helper\build.cmd",
    "dist": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable",
    "typecheck": "tsc -p tsconfig.json",
    "i18n:check": "node scripts/i18n-check.js",
    "notices": "node scripts/third-party-notices.js"
  },
  "author": {
    "name": "Rami al-Hakimi",
    "url": "https://github.com/rami-hakimi"
  },
  "license": "GPL-3.0-only",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "electron": "^44.7.2",
    "electron-builder": "^26.17.0",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "com.soqoisland.app",
    "productName": "Soqo Island",
    "copyright": "Copyright © 2026 Rami al-Hakimi and Soqo Island contributors. Based on Nova Island © 2026 AmerTech (GPL-3.0).",
    "electronLanguages": [
      "en-US",
      "ar",
      "nl"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "build/icon.png",
      "build/icon.ico",
      "build/tray.png",
      "!assets/branding/**",
      "!assets/mascot/**",
      "!assets/ui/**",
      "!assets/screenshots/**",
      "!dist/**",
      "!.github/**",
      "!CONTRIBUTING.md",
      "!CODE_OF_CONDUCT.md",
      "!SECURITY.md",
      "!docs/**",
      "!test/**",
      "!scripts/**",
      "!eslint.config.js",
      "!.editorconfig",
      "!.gitattributes",
      "!*.cmd",
      "!setup-log.txt",
      "!**/*.map",
      "!helper/*.cs",
      "!helper/*.cmd"
    ],
    "publish": {
      "provider": "github",
      "owner": "rami-hakimi",
      "repo": "soqo-island-"
    },
    "asarUnpack": [
      "helper/soqo-helper.exe"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "executableName": "Soqo Island"
    },
    "nsis": {
      "oneClick": false,
      "artifactName": "Soqo-Island-Setup-${version}.${ext}",
      "license": "LICENSE",
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Soqo Island",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "en_US",
        "ar_SA",
        "nl_NL"
      ],
      "multiLanguageInstaller": true,
      "displayLanguageSelector": true
    },
    "portable": {
      "artifactName": "Soqo Island ${version} portable.exe"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "node-ical": "^0.27.3"
  },
  "contributors": [
    "AmerTech (Nova Island, the upstream project, GPL-3.0)"
  ],
  "homepage": "https://github.com/rami-hakimi/soqo-island-",
  "repository": {
    "type": "git",
    "url": "https://github.com/rami-hakimi/soqo-island-.git"
  },
  "bugs": {
    "url": "https://github.com/rami-hakimi/soqo-island-/issues"
  },
  "keywords": [
    "windows",
    "desktop",
    "electron",
    "dynamic-island",
    "companion",
    "productivity",
    "arabic",
    "rtl",
    "music",
    "timer",
    "notifications",
    "soqo-island",
    "soqi"
  ]
}
