{
  "name": "soqo-island",
  "version": "2.0.0-alpha.1",
  "description": "Soqo Island — A Living Island for Windows (سوكو آيلاند)",
  "main": "nova.js",
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check-syntax.js",
    "lint": "eslint .",
    "test": "node --require ./test/helpers/setup.js --test \"test/*.test.js\"",
    "verify": "npm run check && npm run lint && npm test",
    "helper:build": "cmd /c helper\build.cmd",
    "dist": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable"
  },
  "author": "Rami Al-Hakimi",
  "license": "GPL-3.0-only",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "electron": "^44.7.2",
    "electron-builder": "^26.17.0",
    "eslint": "^9.39.5",
    "globals": "^15.15.0"
  },
  "build": {
    "appId": "com.soqoisland.app",
    "productName": "Soqo Island",
    "copyright": "Copyright © 2026 Soqo Island contributors. Based on Nova Island © 2026 AmerTech (GPL-3.0).",
    "electronLanguages": [
      "en-US",
      "ar"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "build/icon.png",
      "build/icon.ico",
      "build/tray.png",
      "!assets/*.png",
      "!promo/**",
      "!dist/**",
      "!docs/**",
      "!test/**",
      "!scripts/**",
      "!eslint.config.js",
      "!.editorconfig",
      "!.gitattributes",
      "!*.cmd",
      "!setup-log.txt",
      "!**/*.map",
      "!helper/*.cs",
      "!helper/*.cmd"
    ],
    "publish": {
      "provider": "github",
      "owner": "rami-hakimi",
      "repo": "soqo-island-"
    },
    "asarUnpack": [
      "helper/soqo-helper.exe"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "executableName": "Soqo Island"
    },
    "nsis": {
      "oneClick": false,
      "artifactName": "Soqo-Island-Setup-${version}.${ext}",
      "license": "LICENSE",
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Soqo Island",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Soqo Island ${version} portable.exe"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "node-ical": "^0.27.3"
  },
  "contributors": [
    "AmerTech (Nova Island, the upstream project)"
  ],
  "homepage": "https://github.com/rami-hakimi/soqo-island-",
  "repository": {
    "type": "git",
    "url": "https://github.com/rami-hakimi/soqo-island-.git"
  },
  "bugs": {
    "url": "https://github.com/rami-hakimi/soqo-island-/issues"
  }
}
